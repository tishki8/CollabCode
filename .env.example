# ---- Database / cache ----
DATABASE_URL=postgresql://collabcode:collabcode@localhost:5432/collabcode
REDIS_URL=redis://localhost:6379

# ---- Service URLs ----
WEB_ORIGIN=http://localhost:3000     # origin of the web app (API uses it for the CSRF check)
API_URL=http://localhost:4000        # where the web app's server reaches the API
API_PORT=4000

# ---- Reverse proxy ----
# Number of reverse proxies in front of the API (the web app's /api/v1 proxy counts as one).
# Used so rate limits see each visitor's real address. 0 when the API is reached directly.
TRUST_PROXY_HOPS=0

# ---- Real-time collaboration ----
# Secret shared by the API (signs short-lived collab tokens) and the collab server (verifies them).
# At least 32 characters. Generate with: openssl rand -base64 48
COLLAB_JWT_SECRET=dev-only-collab-secret-change-me-please-0123456789
# The collab WebSocket URL as the BROWSER reaches it
COLLAB_PUBLIC_URL=ws://localhost:1234
# The collab server as the API reaches it (server to server; signed with COLLAB_JWT_SECRET)
COLLAB_INTERNAL_URL=http://localhost:1234

# ---- Auth.js (https://authjs.dev) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Create OAuth apps and paste their credentials. Callback URLs:
#   Google: http://localhost:3000/api/auth/callback/google
#   GitHub: http://localhost:3000/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Local development only ----
# Enables /api/dev-login to sign in as the seeded demo users without OAuth. NEVER enable in production.
DEV_LOGIN=true
